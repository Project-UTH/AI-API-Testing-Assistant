      "expected": 201,
      "profile": "HR",
      "body": {
        "title": "Backend Developer",
        "description": "Phat trien API",
        "salaryMin": 1000,
        "salaryMax": 2000,
        "salaryCurrency": "USD",
        "jobType": "FULL_TIME",
        "deadline": "{{today+30d}}"
      }
    },
    {
      "key": "J2",
      "name": "J2 Xem tin vừa tạo",
