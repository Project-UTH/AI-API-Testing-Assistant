        "deadline": "{{today+30d}}"
      },
      "dep": {
        "from": "J1",
        "jsonPath": "$.id",
        "placeholder": "id"
      }
    },
    {
      "key": "J4",
      "name": "J4 Đặt rubric cho tin",
      "method": "PUT",
      "specPath": "/api/jobs/{id}/rubric",
      "resolvedPath": "/api/jobs/{{id}}/rubric",
