      "profile": "HR",
      "body": {
        "criteria": [
          {
            "name": "Ky nang",
            "weight": 60,
            "maxScore": 5
          },
          {
            "name": "Kinh nghiem",
            "weight": 40,
            "maxScore": 5
          }
        ]
      },
      "dep": {
        "from": "J1",
