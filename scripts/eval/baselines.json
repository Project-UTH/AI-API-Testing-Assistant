      "specPath": "/api/jobs/{id}",
      "resolvedPath": "/api/jobs/{{id}}",
      "expected": 200,
      "profile": "HR",
      "dep": {
        "from": "J1",
        "jsonPath": "$.id",
        "placeholder": "id"
      }
    },
    {
      "key": "J3",
