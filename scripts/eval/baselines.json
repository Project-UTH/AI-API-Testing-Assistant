{
  "_comment": "Test gốc hợp lệ do NGƯỜI viết cho mutant-api (1 test đúng mỗi endpoint, đúng quy trình khuyến nghị: tự thêm 1 test đúng rồi để hệ thống bù). Dùng cho cấu hình A và tuỳ chọn --seed-baselines của B/C. dep = lấy giá trị từ response của test nguồn. profile: HR = token mặc định của project (hr1), CAND = profile ứng viên (cand1), NONE = không gửi token.",
  "baselines": [
    {
      "key": "L1",
      "name": "L1 Đăng nhập hợp lệ",
      "method": "POST",
      "specPath": "/auth/login",
      "resolvedPath": "/auth/login",
      "expected": 200,
      "profile": "NONE",
      "body": {
        "email": "hr1@demo.local",
        "password": "Passw0rd!"
      }
    },
    {
      "key": "U1",
      "name": "U1 Xem tài khoản của mình",
      "method": "GET",
      "specPath": "/api/users/me",
      "resolvedPath": "/api/users/me",
      "expected": 200,
      "profile": "HR"
    },
    {
      "key": "J1",
      "name": "J1 Tạo tin tuyển dụng hợp lệ",
