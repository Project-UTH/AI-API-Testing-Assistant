# File nay dung RIENG cho docker-compose (khac backend/.env dung khi chay local khong qua Docker).
# Copy file nay thanh ".env" o thu muc goc, roi dien gia tri THAT tu backend/.env sang day.
#
# QUAN TRONG: neu gia tri nao chua ky tu $ (vd JWT_SECRET/AES_SECRET ngau nhien), phai escape
# thanh $$ trong file nay (rieng cho Docker Compose) - vi Compose tu dong hieu $ la tham chieu
# bien moi truong. KHONG escape $ trong chinh backend/.env (file do Spring doc truc tiep, khong
# hieu quy tac escape cua Compose).
DB_PASSWORD=
JWT_SECRET=
AES_SECRET=
ANTHROPIC_API_KEY=

GOOGLE_CLIENT_ID=

MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
# Tuy chon - de trong se dung dung gia tri mac dinh trong frontend/.env hien tai.
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_GOOGLE_CLIENT_ID=
